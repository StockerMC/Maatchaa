# Python Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# For production:
# NEXT_PUBLIC_API_URL=https://api.maatchaa.com

# Demo Mode - Company ID for public demo (matches DEV_COMPANY_ID in backend)
NEXT_PUBLIC_DEMO_COMPANY_ID=your-demo-company-uuid

# NextAuth (if using)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here

# Supabase (if using)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Vector search - used by /api/products/[id]/creators
PINECONE_API_KEY=
PINECONE_INDEX_NAME=products
COHERE_API_KEY=

# Retrieval feature flags - both default off, unset means unchanged behaviour
RETRIEVAL_RERANK_ENABLED=false
COHERE_RERANK_MODEL=rerank-v3.5
RETRIEVAL_CANDIDATE_POOL=30
RETRIEVAL_TOP_N=10
